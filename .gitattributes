# Auto-detect text files and normalize line endings
* text=auto

# Windows batch files must retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Source and documentation files use LF
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.pyd binary
*.dll binary
*.whl binary
*.zip binary
